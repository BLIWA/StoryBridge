rules_version = '2';

// Deny-by-default skeleton. Real collection rules land in Phase 04–06 of the
// roadmap once roles/claims (owner, contributor, ...) and the exact
// collections (articles, pages, issues, subscribers, submissions, staff)
// are confirmed. Nothing is readable or writable until rules are written
// explicitly below — do not relax this by wildcarding "if true" here.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
