# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
# .env.local stays out (per-machine overrides). .env.production is committed on
# purpose: `next build` with output:"export" bakes NEXT_PUBLIC_* into the static
# bundle, so a clone without it silently deploys a CMS whose sign-in cannot
# reach Firebase. Those values are public project identifiers — they are already
# served in the deployed JS — not credentials. See .env.production's own header.
.env*
!.env.example
!.env.production

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
