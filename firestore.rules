rules_version = '2';

// StoryBridge Studio access control.
//
// The grant is a document: a person can use the CMS if and only if
// `staff/{their lowercased email}` exists with `active: true`. That document
// also carries their role, and the role table below mirrors
// apps/cms/src/lib/staff.ts — these rules are the authority, the UI is a
// convenience. Nothing here trusts anything the client sends about identity;
// `request.auth.token.email` is minted by Firebase Auth.
//
// Why documents rather than custom claims: setting a claim requires the Admin
// SDK in a privileged environment (a Cloud Function), which requires Blaze.
// This project is deliberately still on Spark — see the root README. The cost
// is one extra document read per rule evaluation.
//
// /staff, /media and /articles have rules below. Pages, issues, subscribers
// and contact submissions are still in-memory seed data in the CMS (see
// apps/cms/src/content/seed.ts); their collections and rules land with the
// rest of the content modules in roadmap Phase 05–06.
// Do not add a wildcard `if true` here.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }

    // Document ids are lowercased emails, so every comparison must lowercase too.
    function email() {
      return signedIn() ? request.auth.token.email.lower() : '';
    }

    function isSelf(docId) {
      return signedIn() && docId == email();
    }

    function staffPath() {
      return /databases/$(database)/documents/staff/$(email());
    }

    function isStaff() {
      return signedIn()
        && exists(staffPath())
        && get(staffPath()).data.active == true;
    }

    function role() {
      return isStaff() ? get(staffPath()).data.role : 'none';
    }

    // Mirrors the CAPABILITIES table in lib/staff.ts. Clauses land here as the
    // collections those verbs act on exist — /articles is the first; edit
    // pages, send the newsletter and the rest still land with Phase 05–06.
    function canManagePeople() { return role() == 'owner'; }
    function canEditAnyDraft() { return role() in ['owner', 'chief', 'journalist']; }
    function canPublish() { return role() in ['owner', 'chief']; }
    function canEditPages() { return role() in ['owner', 'chief']; }

    match /staff/{staffEmail} {

      function validRole(r) {
        return r in ['owner', 'chief', 'journalist', 'contributor'];
      }

      function wellFormed() {
        return request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 120
          && validRole(request.resource.data.role)
          && request.resource.data.active is bool
          // The id is the identity. Letting a record claim a different address
          // than its own key would make every lookup above meaningless.
          && staffEmail == staffEmail.lower();
      }

      // Reading your own record is what tells a newly invited person they are
      // in — it has to work before they are established as staff.
      allow get: if isStaff() || isSelf(staffEmail);

      // The roster. Staff only: this is the company's contact list.
      allow list: if isStaff();

      allow create: if canManagePeople() && wellFormed();

      allow update: if
        // Owners administer everyone, but may not demote themselves — the last
        // owner clicking the wrong option would lock the project out for good.
        (canManagePeople() && wellFormed()
          && !(isSelf(staffEmail) && request.resource.data.role != resource.data.role))
        // Anyone may stamp their own arrival, and nothing else.
        || (isSelf(staffEmail)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSignInAt']));

      // Revoking your own access has no valid use and no way back.
      allow delete: if canManagePeople() && !isSelf(staffEmail);
    }

    // Metadata for uploads in Storage's /media path (credit, alt text, who
    // uploaded it) — see apps/cms/src/lib/media.ts. Staff-only: the website
    // is still a static export reading apps/website/src/content rather than
    // Firestore, so there is no public consumer of this collection yet.
    // Revisit read access when there is (Phase 05).
    match /media/{fileId} {
      function wellFormedMedia() {
        return request.resource.data.path is string
          && request.resource.data.url is string
          && request.resource.data.credit is string
          && request.resource.data.alt is string
          && request.resource.data.uploadedBy is string;
      }

      allow read: if isStaff();
      allow create: if isStaff() && wellFormedMedia();
      allow update, delete: if isStaff();
    }

    // Journal articles — see apps/cms/src/lib/articles.ts. The website reads
    // this collection at build time now (apps/website/src/lib/articles.ts),
    // so a Published piece is public; every other status (drafts, review,
    // scheduled) stays staff-only — nobody outside the team gets to see work
    // in progress. `authorEmail` is the ownership key — `author` on the
    // document is just a display name, not proof of anything.
    match /articles/{articleId} {
      function validStatus(s) {
        return s in ['Draft', 'In review', 'Scheduled', 'Published'];
      }

      function wellFormedArticle() {
        return request.resource.data.title is string
          && request.resource.data.slug is string
          && validStatus(request.resource.data.status)
          && request.resource.data.authorEmail is string
          && request.resource.data.authorEmail == request.resource.data.authorEmail.lower();
      }

      // Anyone on staff may write their own drafts (the board's "own drafts
      // only" contributor scope); owner/chief/journalist may write anyone's.
      function isOwnDraft() {
        return isStaff() && resource.data.authorEmail == email();
      }

      // Setting status to Published from the client is an owner/chief verb;
      // every other status transition (draft edits, sending to review,
      // scheduling) is open to whoever may touch the document at all.
      function statusChangeAllowed() {
        return request.resource.data.status == resource.data.status || canPublish();
      }

      // Firestore requires the client's own query to filter by `status` for
      // this to work without reading the whole collection (rules constrain a
      // list request, they don't post-filter it) — see listPublishedArticles()
      // on the website, which always queries with `where('status','==',...)`.
      allow read: if isStaff() || resource.data.status == 'Published';

      allow create: if isStaff()
        && wellFormedArticle()
        && request.resource.data.authorEmail == email()
        // Can't hand yourself a published piece on the way in — publishing
        // is always a transition on an existing draft, never day-one status.
        && request.resource.data.status != 'Published';

      allow update: if isStaff()
        && wellFormedArticle()
        // authorEmail is the ownership key — it doesn't move after creation,
        // the same way a staff document can't reassign its own identity.
        && request.resource.data.authorEmail == resource.data.authorEmail
        && (canEditAnyDraft() || isOwnDraft())
        && statusChangeAllowed();

      // Not exposed in the UI yet — kept consistent with the roles that can
      // already touch any draft, rather than left to fall through to deny.
      allow delete: if canEditAnyDraft();
    }

    // Site pages & sections — see apps/cms/src/lib/pages.ts. Editing pages is
    // the `editPages` capability in lib/staff.ts (owner/chief), not the
    // "own drafts" model articles use — nobody authors a page alone. No
    // public consumer yet: the website's marketing copy still comes from its
    // own next-intl message catalogs, not this collection (see the roadmap —
    // reconciling those two is a separate, undecided piece of work).
    match /pages/{pageKey} {
      function wellFormedPage() {
        return request.resource.data.order is list && request.resource.data.sections is map;
      }

      allow read: if isStaff();
      allow write: if isStaff() && canEditPages() && wellFormedPage();
    }

    // Contact-form submissions — see apps/website/src/lib/submissions.ts. The
    // one collection in this project a non-staff caller can write to at all:
    // the public site posts directly, no Cloud Function in between (Blaze —
    // see the root README). Everything here is about containing that: field
    // presence, generous but real length caps, and a status that can only
    // ever start at 'New' from the client. Once a document exists, editing
    // it is staff-only, and the only field they may change is `status` — a
    // submission's own content isn't staff's to rewrite.
    match /submissions/{submissionId} {
      function wellFormedSubmission() {
        return request.resource.data.name is string
          && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 200
          && request.resource.data.email is string
          && request.resource.data.email.size() > 0 && request.resource.data.email.size() <= 200
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0 && request.resource.data.body.size() <= 5000
          && request.resource.data.status == 'New';
      }

      allow create: if wellFormedSubmission();
      allow read: if isStaff();
      allow update: if isStaff() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
    }

    // Newsletter subscribers — see apps/website/src/lib/subscribers.ts. Same
    // "public can create, staff can read" shape as /submissions above, for
    // the same reason (no Function to stand between the form and the
    // write). Document id is the lowercased email, so create doubles as
    // "resubscribe" for free — Firestore just overwrites.
    match /subscribers/{email} {
      function wellFormedSubscriber() {
        return request.resource.data.status == 'Subscribed' && email == email.lower();
      }

      allow create: if wellFormedSubscriber();
      allow read: if isStaff();
      allow update: if isStaff();
    }

    // Deny-by-default for everything else. See the note at the top of this file.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
