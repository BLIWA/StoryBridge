# Firebase web app config — Firebase Console → Project settings → General → Your apps,
# or: firebase apps:sdkconfig WEB --project <project-id>
#
# The real values for the "sotrybridge" project are committed in .env.production
# (they are public identifiers, not secrets). Copy this file to .env.local only
# when pointing the CMS at a different Firebase project.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=sotrybridge
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
