# Committed on purpose. `next build` with output:"export" bakes these into the
# static bundle, so the deploy would silently ship an unconfigured CMS if they
# only lived in a git-ignored .env.local on one laptop. Firebase web config is
# a public project identifier, not a credential — the security boundary is
# Firebase Auth + firestore.rules. See apps/cms/README.md.
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyBOY4ylBmt2c7JwT6LmeuUosXMLIasDTGY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=storybridge-eb71e.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=storybridge-eb71e
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=storybridge-eb71e.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=358960111108
NEXT_PUBLIC_FIREBASE_APP_ID=1:358960111108:web:bcd23cd38521d7cd489f51
