rules_version = '2';

// Deny-by-default skeleton — mirrors firestore.rules. The CMS media library
// (Phase 05) will need authenticated-write / public-read rules scoped to a
// path like /media/{file}, added once roles are finalized.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
