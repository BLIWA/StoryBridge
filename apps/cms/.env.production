# Committed on purpose. `next build` with output:"export" bakes these into the
# static bundle, so the deploy would silently ship an unconfigured CMS if they
# only lived in a git-ignored .env.local on one laptop. Firebase web config is
# a public project identifier, not a credential — the security boundary is
# Firebase Auth + firestore.rules. See apps/cms/README.md.
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyDunIw_KTfVMN0WazJSdiTGBBvEWnHzAXI
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=sotrybridge.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=sotrybridge
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=sotrybridge.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=423175363625
NEXT_PUBLIC_FIREBASE_APP_ID=1:423175363625:web:09905bae5b1816231b9038
